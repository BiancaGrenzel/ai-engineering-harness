# Include canonical project content in sdists so wheels built from an sdist
# can still populate harness/content/_data via the setuptools build hook.
include pyproject.toml
include setup.py
include README.md
include LICENSE
include CHANGELOG.md

graft harness
graft adapters

recursive-include schemas *.json
recursive-include profiles *.yaml
recursive-include rules *.md
recursive-include skills *.md
include tools/registry.yaml
# Only Tool docs needed for Registry documentation references / packaging.
recursive-include docs/tools/token *.md

global-exclude __pycache__ *.py[cod] .DS_Store
prune tests
prune scripts
prune build
prune dist
prune .venv
prune .git
prune .cursor
prune .claude
prune docs/architecture
prune docs/project
prune docs/templates