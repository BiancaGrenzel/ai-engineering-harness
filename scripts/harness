#!/usr/bin/env python3
"""Local launcher for the Harness CLI without packaging.

Adds this repository root to ``sys.path``, then runs ``harness.cli.main``.
Useful when invoking from a subdirectory without setting PYTHONPATH.

    python scripts/harness validate
    python scripts/harness generate cursor --dry-run
"""

from __future__ import annotations

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from harness.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
